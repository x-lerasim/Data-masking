# Скопируйте в .env: cp .env.example .env
# Соль генерируется отдельной командой (см. README) и дописывается в .env.
# .env в git не попадает (.gitignore).

# ClickHouse: администратор (только для init-скрипта), ETL и ML-пользователи
CLICKHOUSE_ADMIN_PASSWORD=admin_pass
ETL_USER_PASSWORD=etl_pass
ML_USER_PASSWORD=ml_pass

# Минимальный размер группы для k-анонимности
K_MIN=5
